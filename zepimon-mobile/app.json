{
  "expo": {
    "name": "Zepimon",
    "slug": "zepimon-mobile",
    "version": "1.7.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "zepimon",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zepimon.companion"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#1C0D3F"
      },
      "package": "com.zepimon.companion",
      "versionCode": 11
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5881b77f-9523-4bff-9eff-bf4da8565240"
      }
    }
  }
}
